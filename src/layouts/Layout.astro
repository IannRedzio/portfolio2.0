---
import '../styles/global.css';
import AnimatedBackground from '../components/AnimatedBackground.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { 
	title = 'IR | Programador FullStack', 
	description = 'Portfolio personal de Ian Redzio, Programador FullStack especializado en crear aplicaciones web.',
	image = '/og-image.jpg'
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Ian Redzio',
	jobTitle: 'Desarrollador Full Stack',
	url: Astro.site?.toString(),
	email: 'mailto:ianredzio13@gmail.com',
	address: { '@type': 'PostalAddress', addressLocality: 'Buenos Aires', addressCountry: 'AR' },
	sameAs: ['https://linkedin.com/in/ian-redzio', 'https://github.com/IannRedzio'],
};

---

<html lang="es" class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#0E0E29" />

    <!-- Open Graph: vista previa al compartir en LinkedIn, WhatsApp, etc. -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Ian Redzio" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Portfolio de Ian Redzio, Desarrollador Full Stack" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script>
      (function() {
        const getSystemTheme = () => {
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        };
        
        const savedTheme = localStorage.getItem('theme');
        const systemTheme = getSystemTheme();
        const theme = savedTheme && (savedTheme === 'dark' || savedTheme === 'light') 
          ? savedTheme 
          : 'dark'; 
        
        const html = document.documentElement;
        if (theme === 'dark') {
          html.classList.add('dark');
        } else {
          html.classList.remove('dark');
        }
        
        if (!savedTheme) {
          localStorage.setItem('theme', theme);
        }
      })();
    </script>
    <style>
      :root {
        --color-primary: #0E0E29;
        --color-primary-dark: #080818;
      }
      
      body {
        font-family: 'Inter', sans-serif;
        margin: 0;
        padding: 0;
      }
    </style>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        window.scrollTo(0, 0);
        document.documentElement.scrollTop = 0;
        document.body.scrollTop = 0;
      });
    </script>
  </head>
  <body>
    <AnimatedBackground />
    <slot />
  </body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		height: 100%;
	}
</style>
