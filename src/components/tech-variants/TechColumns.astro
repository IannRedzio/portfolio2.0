---
// Variante A: tres columnas por área, como una ficha técnica
import { groups } from './data';
---

<section class="content-container py-4 sm:py-6 md:py-10">
  <div class="px-4">
    <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-ink dark:text-mist mb-8 md:mb-10">
      <span class="border-b-2 border-brand dark:border-brand-night pb-1">Tecnologías y herramientas que uso</span>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
      {groups.map((group) => (
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-brand dark:text-brand-night mb-3">
            {group.area} <span class="text-ink-muted dark:text-mist-muted">/ {String(group.items.length).padStart(2, '0')}</span>
          </p>
          <ul class="border-t border-line dark:border-night-line-strong">
            {group.items.map((tech) => (
              <li class="group flex items-center gap-3 py-3 border-b border-line dark:border-night-line-strong">
                <svg class="w-5 h-5 text-ink-muted dark:text-mist-muted group-hover:text-[var(--c)] transition-colors" style={`--c: ${tech.color ?? 'currentColor'}`} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={tech.icon.path} /></svg>
                <span class="text-lg font-medium text-ink dark:text-mist">{tech.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
