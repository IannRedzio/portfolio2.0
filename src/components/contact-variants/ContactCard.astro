---
// Variante C: tarjeta de presentación con disponibilidad y hora local
const email = 'ianredzio13@gmail.com';
---

<section class="content-container py-6 md:py-10 flex flex-col min-h-full">
  <div class="flex-1 flex flex-col justify-center items-center px-4">
    <div class="relative w-full max-w-lg rounded-2xl p-[1px] bg-gradient-to-br from-brand/60 via-line to-signal/50 dark:from-brand-night/70 dark:via-night-line dark:to-signal/50">
      <div class="rounded-2xl bg-paper-raised/90 dark:bg-night-raised/80 backdrop-blur-md p-7 sm:p-9">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-16 h-16 rounded-full bg-gradient-to-br from-brand to-brand-night flex items-center justify-center text-white text-xl font-bold shadow-lg">IR</div>
          <div>
            <p class="text-xl font-bold text-ink dark:text-mist">Ian Redzio</p>
            <p class="text-ink-soft dark:text-mist-soft">Desarrollador Full Stack</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-2 mb-6">
          <span class="inline-flex items-center gap-2 text-sm px-3 py-1.5 rounded-full bg-[#28C840]/10 text-[#1E8E3E] dark:text-[#5BE37D] border border-[#28C840]/30">
            <span class="relative flex w-2 h-2"><span class="absolute inset-0 rounded-full bg-[#28C840] animate-ping opacity-75"></span><span class="relative w-2 h-2 rounded-full bg-[#28C840]"></span></span>
            Disponible para nuevos proyectos
          </span>
          <span class="inline-flex items-center gap-2 text-sm px-3 py-1.5 rounded-full border border-line dark:border-night-line-strong text-ink-soft dark:text-mist-soft">
            📍 Buenos Aires · <span id="local-time">--:--</span>
          </span>
        </div>

        <p class="text-ink-soft dark:text-mist-soft mb-6">¿Tienes una propuesta? Escríbeme y conversemos.</p>

        <a href={`mailto:${email}`} class="flex items-center justify-center gap-2 w-full py-3.5 rounded-xl bg-brand hover:bg-brand-hover text-white dark:bg-brand-night dark:text-night dark:hover:bg-brand-night-hover font-semibold transition-all hover:-translate-y-0.5 mb-3">
          Enviar un email
        </a>
        <div class="grid grid-cols-3 gap-2">
          <a href="https://linkedin.com/in/ian-redzio" class="text-center py-2.5 rounded-lg border border-line dark:border-night-line-strong text-ink dark:text-mist text-sm font-medium hover:bg-paper-sunk dark:hover:bg-white/5 transition-colors">LinkedIn</a>
          <a href="https://github.com/IannRedzio" class="text-center py-2.5 rounded-lg border border-line dark:border-night-line-strong text-ink dark:text-mist text-sm font-medium hover:bg-paper-sunk dark:hover:bg-white/5 transition-colors">GitHub</a>
          <a href="/Ian-Redzio-CV-DevFullStack.pdf" class="text-center py-2.5 rounded-lg border border-line dark:border-night-line-strong text-ink dark:text-mist text-sm font-medium hover:bg-paper-sunk dark:hover:bg-white/5 transition-colors">CV</a>
        </div>
      </div>
    </div>
  </div>
  <footer class="pt-8 text-center text-sm text-ink-muted dark:text-mist-muted">© 2026 Ian Redzio</footer>
</section>

<script>
  const el = document.getElementById('local-time');
  const update = () => {
    if (el) el.textContent = new Intl.DateTimeFormat('es-AR', { hour: '2-digit', minute: '2-digit', timeZone: 'America/Argentina/Buenos_Aires' }).format(new Date());
  };
  update();
  setInterval(update, 30000);
</script>
