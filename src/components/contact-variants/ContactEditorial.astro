---
// Variante B: editorial, tipografía grande y filas con flecha
const email = 'ianredzio13@gmail.com';
const rows = [
  { label: 'LinkedIn', value: 'in/ian-redzio', href: 'https://linkedin.com/in/ian-redzio' },
  { label: 'GitHub', value: '@IannRedzio', href: 'https://github.com/IannRedzio' },
  { label: 'Currículum', value: 'Descargar PDF', href: '/Ian-Redzio-CV-DevFullStack.pdf' },
];
---

<section class="content-container py-6 md:py-10 flex flex-col min-h-full">
  <div class="flex-1 grid md:grid-cols-[1.1fr_1fr] gap-10 md:gap-16 items-center max-w-5xl mx-auto w-full px-4">
    <div>
      <p class="text-sm uppercase tracking-[0.25em] text-brand dark:text-brand-night font-semibold mb-4">Contacto</p>
      <h2 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-ink dark:text-mist leading-[0.95] tracking-tight mb-6">
        Hablemos<span class="text-brand dark:text-signal">.</span>
      </h2>
      <p class="text-ink-soft dark:text-mist-soft text-lg max-w-sm mb-8">
        ¿Tienes un proyecto o una propuesta? Escríbeme y te respondo a la brevedad.
      </p>
      <a href={`mailto:${email}`} class="group inline-flex items-center gap-3 text-xl sm:text-2xl font-semibold text-ink dark:text-mist">
        <span class="bg-[linear-gradient(currentColor,currentColor)] bg-[length:0%_2px] bg-left-bottom bg-no-repeat group-hover:bg-[length:100%_2px] transition-[background-size] duration-300 pb-1">{email}</span>
        <span class="text-brand dark:text-brand-night transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>
      </a>
    </div>

    <ul class="border-t border-line dark:border-night-line-strong">
      {rows.map((row) => (
        <li>
          <a href={row.href} target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between py-6 border-b border-line dark:border-night-line-strong">
            <span>
              <span class="block text-2xl font-semibold text-ink dark:text-mist group-hover:text-brand dark:group-hover:text-brand-night transition-colors">{row.label}</span>
              <span class="block text-sm text-ink-muted dark:text-mist-muted">{row.value}</span>
            </span>
            <span class="text-2xl text-ink-muted dark:text-mist-muted group-hover:text-brand dark:group-hover:text-brand-night transition-all duration-300 group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <footer class="pt-8 text-center text-sm text-ink-muted dark:text-mist-muted">© 2026 Ian Redzio · Buenos Aires, Argentina</footer>
</section>
