---
// Variante A: ventana de terminal
const email = 'ianredzio13@gmail.com';
---

<section class="content-container py-6 md:py-10 flex flex-col min-h-full">
  <div class="flex-1 flex flex-col justify-center max-w-2xl mx-auto w-full px-4">
    <h2 class="text-2xl sm:text-3xl font-bold text-ink dark:text-mist text-center mb-8">
      <span class="border-b-2 border-brand dark:border-brand-night pb-1">Contacto</span>
    </h2>

    <div class="rounded-xl overflow-hidden border border-line dark:border-night-line-strong bg-paper-raised/85 dark:bg-[#0A0A20]/80 backdrop-blur-md card-shadow-hover font-mono text-sm sm:text-base">
      <div class="flex items-center gap-2 px-4 py-3 border-b border-line dark:border-night-line bg-paper-sunk/60 dark:bg-white/[0.03]">
        <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span>
        <span class="w-3 h-3 rounded-full bg-[#FEBC2E]"></span>
        <span class="w-3 h-3 rounded-full bg-[#28C840]"></span>
        <span class="ml-3 text-xs text-ink-muted dark:text-mist-muted">ian@buenos-aires: ~</span>
      </div>
      <div class="p-5 sm:p-6 space-y-2 text-ink-soft dark:text-mist-soft">
        <p><span class="text-brand dark:text-brand-night">$</span> whoami</p>
        <p class="pl-4 text-ink dark:text-mist">Ian Redzio — Full Stack Developer</p>
        <p><span class="text-brand dark:text-brand-night">$</span> cat contacto.json</p>
        <pre class="pl-4 leading-relaxed whitespace-pre-wrap">{'{'}
  <span class="text-ink-muted dark:text-mist-muted">"email"</span>:    <a href={`mailto:${email}`} class="text-brand dark:text-signal underline decoration-dotted underline-offset-4 hover:decoration-solid">"{email}"</a>,
  <span class="text-ink-muted dark:text-mist-muted">"linkedin"</span>: <a href="https://linkedin.com/in/ian-redzio" class="text-brand dark:text-signal underline decoration-dotted underline-offset-4 hover:decoration-solid">"in/ian-redzio"</a>,
  <span class="text-ink-muted dark:text-mist-muted">"github"</span>:   <a href="https://github.com/IannRedzio" class="text-brand dark:text-signal underline decoration-dotted underline-offset-4 hover:decoration-solid">"@IannRedzio"</a>,
  <span class="text-ink-muted dark:text-mist-muted">"cv"</span>:       <a href="/Ian-Redzio-CV-DevFullStack.pdf" class="text-brand dark:text-signal underline decoration-dotted underline-offset-4 hover:decoration-solid">"descargar.pdf"</a>
{'}'}</pre>
        <p><span class="text-brand dark:text-brand-night">$</span> status</p>
        <p class="pl-4 flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-[#28C840] animate-pulse"></span> Disponible para nuevas oportunidades</p>
        <p><span class="text-brand dark:text-brand-night">$</span> <span class="inline-block w-2 h-4 align-middle bg-ink dark:bg-mist animate-pulse"></span></p>
      </div>
    </div>
  </div>
  <footer class="pt-8 text-center text-sm text-ink-muted dark:text-mist-muted">© 2026 Ian Redzio</footer>
</section>
