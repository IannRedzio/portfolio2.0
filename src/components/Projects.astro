---

interface Project {
  title: string;
  description: string;
  image: any;
  tags: string[];
  url: string;
  code: string;
  // El proyecto destacado se muestra grande; el resto, en lista
  featured?: boolean;
}

const projects: Project[] = [
  {
    title: "Minijuego: Quiz de preguntas",
    description: "Minijuego de preguntas y respuestas con un tema en común. Basado en Quien quiere ser millonario.",
    image: "/images/QuizzApp.png",
    tags: ["React", "JavaScript", "HTML", "CSS"],
    url: "https://quizz-app-eight.vercel.app/",
    code: "https://github.com/IannRedzio/quizz-app"
  },
  {
    title: "Google Search - Clone",
    description: "Clon de la interfaz de Google Search. Basado en la página de Google Search.",
    image: "/images/GoogleClone.png",
    tags: ["React", "JavaScript", "HTML", "CSS"],
    url: "https://google-clon-homepage.vercel.app/",
    code: "https://github.com/IannRedzio/google-homepage"
  },
  {
    title: "League of Legends Web Idea",
    description: "Aplicación sobre Personajes de League of Legends para practicar maquetado y Animaciones avanzadas.",
    image: "/images/LeagueOfLegendsWeb.png",
    tags: ["React", "JavaScript", "HTML", "CSS", "Vite"],
    url: "https://league-of-legends-three.vercel.app/",
    code: "https://github.com/IannRedzio/league_of_legends_app",
    featured: true
  },
  {
    title: "Portfolio Personal",
    description: "Mi portfolio personal construido con Astro y Tailwind CSS.",
    image: "/images/Portfolio.webp",
    tags: ["Astro", "Tailwind CSS", "TypeScript"],
    url: "https://ianredzio-portfolio.vercel.app/",
    code: "https://github.com/IannRedzio/portfolio2.0"
  }
];

const featured = projects.find((p) => p.featured) ?? projects[0];
const others = projects.filter((p) => p !== featured);
const imgSrc = (image: any) => (typeof image === 'string' ? image : image.src);
---

<section class="content-container smooth-transition py-2 md:py-6">
  <div class="px-4">
    <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-ink dark:text-mist mb-4 md:mb-6">
      <span class="border-b-2 border-brand dark:border-brand-night pb-1">Proyectos destacados</span>
    </h2>

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] gap-6 lg:gap-10 items-start">
      <!-- Proyecto destacado: imagen grande -->
      <article class="group">
        <a href={featured.url} target="_blank" rel="noopener noreferrer" class="block overflow-hidden rounded-xl border border-line dark:border-night-line bg-paper-sunk dark:bg-night-line aspect-[16/9]" aria-label={`Ver ${featured.title}`}>
          <img
            src={imgSrc(featured.image)}
            alt={`Captura de ${featured.title}`}
            loading="lazy"
            decoding="async"
            data-project-img
            class="w-full h-full object-cover object-top group-hover:scale-[1.02] transition-transform duration-500"
          />
        </a>
        <div class="mt-4">
          <h3 class="text-xl md:text-2xl font-bold text-ink dark:text-mist leading-tight">{featured.title}</h3>
          <p class="text-ink-soft dark:text-mist-soft text-base mt-2 mb-3 leading-relaxed max-w-xl">{featured.description}</p>
          <ul class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-ink-muted dark:text-mist-muted mb-4" aria-label="Tecnologías">
            {featured.tags.map((tag) => <li>{tag}</li>)}
          </ul>
          <div class="flex gap-2 flex-wrap">
            <a
              href={featured.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 bg-brand hover:bg-brand-hover text-brand-contrast text-sm font-medium rounded-lg transition-all duration-200 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2 dark:focus:ring-offset-night min-h-[44px] dark:bg-brand-night dark:text-night dark:hover:bg-brand-night-hover dark:focus:ring-brand-night"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              Ver proyecto
            </a>
            <a
              href={featured.code}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 bg-transparent hover:bg-paper-sunk dark:hover:bg-night-raised border border-line-strong dark:border-night-line-strong text-ink dark:text-mist text-sm font-medium rounded-lg transition-all duration-200 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-line-strong focus:ring-offset-2 dark:focus:ring-offset-night min-h-[44px]"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
              Ver código
            </a>
          </div>
        </div>
      </article>

      <!-- Resto de proyectos: lista compacta -->
      <ul class="border-t border-line dark:border-night-line-strong">
        {others.map((project) => (
          <li class="group flex gap-4 py-4 border-b border-line dark:border-night-line-strong">
            <a href={project.url} target="_blank" rel="noopener noreferrer" class="shrink-0 self-start w-24 sm:w-28 aspect-[4/3] overflow-hidden rounded-md border border-line dark:border-night-line bg-paper-sunk dark:bg-night-line" tabindex="-1" aria-hidden="true">
              <img
                src={imgSrc(project.image)}
                alt=""
                loading="lazy"
                decoding="async"
                data-project-img
                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-300"
              />
            </a>
            <div class="min-w-0 flex-1">
              <h3 class="text-base md:text-lg font-semibold text-ink dark:text-mist leading-tight">
                <a href={project.url} target="_blank" rel="noopener noreferrer" class="hover:text-brand dark:hover:text-brand-night transition-colors">{project.title}</a>
              </h3>
              <p class="text-ink-soft dark:text-mist-soft text-sm mt-1 line-clamp-2 leading-relaxed">{project.description}</p>
              <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-2 text-xs">
                <span class="font-mono text-ink-muted dark:text-mist-muted">{project.tags.join(' · ')}</span>
                <a href={project.code} target="_blank" rel="noopener noreferrer" class="font-medium text-brand dark:text-brand-night hover:underline underline-offset-4">Código ↗</a>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const projectImages = document.querySelectorAll('[data-project-img]');
    projectImages.forEach(img => {
      img.addEventListener('error', () => {
        (img as HTMLImageElement).src = '/images/placeholder.svg';
      }, { once: true });
    });
  });
</script>
