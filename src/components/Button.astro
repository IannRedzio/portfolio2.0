---
interface Props {
  href: string;
  variant?: 'primary' | 'outline';
  class?: string;
}

const { 
  href, 
  variant = 'primary', 
  class: className = ''
} = Astro.props;

const baseClasses = "inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full text-sm font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 hover:transform hover:scale-105 active:scale-95 min-h-[44px]";

const variantClasses = {
  primary: "bg-brand hover:bg-brand-hover text-white border border-brand hover:border-brand-hover shadow-md hover:shadow-lg dark:bg-brand-night dark:text-night dark:hover:bg-brand-night-hover dark:border-brand-night dark:hover:border-brand-night-hover focus:ring-brand dark:focus:ring-brand-night focus:ring-offset-paper dark:focus:ring-offset-night",
  outline: "bg-transparent hover:bg-brand-tint dark:hover:bg-brand-night-tint text-brand dark:text-brand-night border-2 border-brand dark:border-brand-night hover:border-brand-hover dark:hover:border-brand-night-hover focus:ring-brand dark:focus:ring-brand-night focus:ring-offset-paper dark:focus:ring-offset-night"
};

const classes = `${baseClasses} ${variantClasses[variant]} ${className}`;
---

<a href={href} class={classes}>
  <slot />
</a>

 